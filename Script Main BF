-- Compra o chip. Em modo Fruta: antes de pagar, guarda no inventário TODA fruta proibida (Mítica, Lendária
-- no modo -1M, skin ou desconhecida). Se alguma não puder ser guardada, NÃO paga.
local function payChip()
    if Config.PayMode == "Fruta" then
        local usable, blocked = {}, {}
        for _, t in ipairs(physicalFruits()) do
            if payEligible(fruitInfo(t), Config.PayOnly1M) then usable[#usable + 1] = t else blocked[#blocked + 1] = t end
        end
        if #usable == 0 then
            Diag.raid = "Auto Pay (fruta): nenhuma fruta permitida na mochila (nada foi gasto)"
            return false
        end
        for _, t in ipairs(blocked) do
            invoke("StoreFruit", t:GetAttribute("OriginalName") or t.Name, t)
            task.wait(0.4)
        end
        for _, t in ipairs(blocked) do
            if t.Parent == Player.Backpack or t.Parent == Player.Character then
                Diag.raid = "Auto Pay (fruta): não consegui guardar " .. t.Name .. " (proibida). NÃO paguei."
                return false
            end
        end
        local _, _, hum = getChar()
        if hum and usable[1].Parent then pcall(function() hum:EquipTool(usable[1]) end) end
        task.wait(0.3)
    end
    local ok, r = invoke("RaidsNpc", "Select", Config.RaidType)
    Diag.raid = string.format("Auto Pay (%s) %s -> %s", Config.PayMode, Config.RaidType, ok and describe(r) or ("erro: " .. tostring(r)))
    task.wait(1)
    return hasChip()
end


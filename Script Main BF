-- ============ INIMIGOS ============
local function enemiesList()
    local f = workspace:FindFirstChild("Enemies")
    return f and f:GetChildren() or {}
end

-- Nome do mob bate se for igual OU começar com o nome (ex.: "Bandit [Lv. 5]")
local function matchName(enemyName, names)
    for _, n in ipairs(names) do
        if enemyName == n or string.sub(enemyName, 1, #n) == n then return true end
    end
    return false
end

local function aliveParts(e)
    local eh, er = e:FindFirstChildOfClass("Humanoid"), e:FindFirstChild("HumanoidRootPart")
    if eh and er and eh.Health > 0 then return eh, er end
end

local function findEnemy(names)
    local _, hrp = getChar()
    if not hrp then return end
    local best, bestDist = nil, math.huge
    for _, e in ipairs(enemiesList()) do
        local eh, er = aliveParts(e)
        if eh and matchName(e.Name, names) then
            local d = (hrp.Position - er.Position).Magnitude
            if d < bestDist then best, bestDist = e, d end
        end
    end
    return best
end

local function countAlive(names)
    local n = 0
    for _, e in ipairs(enemiesList()) do
        if aliveParts(e) and matchName(e.Name, names) then n += 1 end
    end
    return n
end

-- ============ LOTES DE 2 MOBS ============
-- Mesmo com Bring alto (ex.: 4 mobs juntos), só 2 mobs por vez são atacados; a cada ~1,5s (ou quando
-- o par morre) passa para os 2 seguintes. Isso reduz o risco de ban.
local Batch = { pair = {}, idx = 1, switchAt = 0, expires = 0 }
function Batch.update(group)
    local alive = {}
    for _, m in ipairs(group) do
        if aliveParts(m) then alive[#alive + 1] = m end
    end
    local chunks = math.max(1, math.ceil(#alive / 2))
    local now = os.clock()
    if now >= Batch.switchAt then
        Batch.idx = Batch.idx % chunks + 1
        Batch.switchAt = now + 1.5
    end
    if Batch.idx > chunks then Batch.idx = 1 end
    Batch.pair = { alive[Batch.idx * 2 - 1], alive[Batch.idx * 2] }
    Batch.expires = now + 0.5
end

-- ============ NET (seu attack.lua, usado no método "Net") ============
-- Mesma lógica do script enviado: RegisterAttack + RegisterHit + remote de validação.
-- Diferenças: (1) só dispara quando o hub está atacando; (2) bate SOMENTE em workspace.Enemies
-- (a pasta Characters, onde ficam os outros jogadores, foi removida); (3) as esperas têm timeout,
-- para o script não travar se alguma pasta/remote não existir.
-- Normal Attack = 1 ataque por vez (como o seu loop). Fast = 5 simultâneos, Super Fast = 8, sem esperar nada; o FREIO AUTOMÁTICO (pelo FPS) reduz sozinho se o jogo começar a engasgar.
local NetAtk = { ready = false, inflight = 0, lastDone = 0, err = "iniciando...", remote = nil, id = nil,
    netModule = nil, seed = nil, reg = nil, hit = nil, cloneref = nil }
-- Limites anti-crash: poucos alvos por ciclo, poucos ciclos simultâneos e intervalo mínimo entre ciclos
local NET_LIMIT = { ["Normal Attack"] = 1, ["Fast Attack"] = 5, ["Super Fast Attack"] = 8 }
local NET_GAP   = { ["Normal Attack"] = 0.10, ["Fast Attack"] = 0.015, ["Super Fast Attack"] = 0 } -- Super: sem intervalo (1 lote por frame)
local NET_MAX_TARGETS = 2 -- no máximo 2 mobs por golpe
local netLastLaunch = 0

-- Freio anti-crash: mede o tempo dos frames. Se o jogo engasgar (frame > ~45ms em média), o ataque cai
-- para 1 ciclo por vez e só volta ao normal quando o FPS se recuperar.
local Perf = { ema = 0.016, slow = false }
table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    Perf.ema = Perf.ema * 0.9 + math.min(dt, 0.5) * 0.1
    if Perf.ema > 0.045 then Perf.slow = true elseif Perf.ema < 0.03 then Perf.slow = false end
end))

task.spawn(function()
    NetAtk.cloneref = cloneref or function(x) return x end
    local folders = {}
    for _, name in ipairs({ "Util", "Common", "Remotes", "Assets", "FX" }) do
        local f = ReplicatedStorage:WaitForChild(name, 5)
        if f then folders[#folders + 1] = f end
    end
    local function check(obj)
        if obj:IsA("RemoteEvent") and obj:GetAttribute("Id") then
            NetAtk.remote, NetAtk.id = obj, obj:GetAttribute("Id")
        end
    end
    for _, folder in ipairs(folders) do
        for _, child in ipairs(folder:GetChildren()) do check(child) end
        table.insert(Connections, folder.ChildAdded:Connect(check))
    end
    local ok, err = pcall(function()
        local modules = ReplicatedStorage:WaitForChild("Modules", 5)
        local netFolder = modules and modules:WaitForChild("Net", 5)
        assert(netFolder, "ReplicatedStorage.Modules.Net não encontrado")
        NetAtk.netModule = require(netFolder)
        NetAtk.seed = netFolder:WaitForChild("seed", 5)
        NetAtk.reg = netFolder:WaitForChild("RE/RegisterAttack", 5)
        NetAtk.hit = netFolder:WaitForChild("RE/RegisterHit", 5)
        assert(NetAtk.seed and NetAtk.reg and NetAtk.hit, "remotes de ataque não encontrados")
    end)
    NetAtk.ready = ok
    NetAtk.lastDone = os.clock()
    NetAtk.err = ok and "ok" or tostring(err)
    if not ok then Watch.skip["Net"] = true end -- sem os remotes: sai do ciclo automático
end)

-- Um ciclo do seu loop
local function netAttackOnce()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local weaponType = tool:GetAttribute("WeaponType") or tool.ToolTip
    -- Melee e Sword sempre; fruta só quando "Blox Fruit (M1)" estiver selecionado
    if weaponType ~= "Melee" and weaponType ~= "Sword"
        and not (Config.Weapon == "Blox Fruit" and weaponType == "Blox Fruit") then return end

    -- alvos: só inimigos (NPCs) a até 60 studs
    local targets = {}
    local source = (os.clock() < Batch.expires) and Batch.pair or enemiesList()
    for _, enemy in ipairs(source) do
        local eh, er = aliveParts(enemy)
        if eh and (er.Position - root.Position).Magnitude <= 60 then
            targets[#targets + 1] = { enemy, er } -- 1 parte por mob (mandar todas as partes travava o jogo)
            if #targets >= NET_MAX_TARGETS then break end
        end
    end
    if #targets == 0 then return end

    -- registra o RegisterHit no máximo 1x por segundo (repetir isso a cada ciclo acumulava conexões)
    if os.clock() - (NetAtk.regAt or 0) > 1 then
        NetAtk.regAt = os.clock()
        NetAtk.netModule:RemoteEvent("RegisterHit", true)
    end
    NetAtk.reg:FireServer()

    local head = targets[1][1]:FindFirstChild("Head")
    if head and NetAtk.remote and NetAtk.id then
        local uidStr = tostring(Player.UserId):sub(2, 4)
        local coStr = tostring(coroutine.running()):sub(11, 15)
        NetAtk.hit:FireServer(head, targets, {}, uidStr .. coStr)

        local remoteName = string.gsub("RE/RegisterHit", ".", function(c)
            return string.char(bit32.bxor(string.byte(c), math.floor((workspace:GetServerTimeNow() / 10) % 10) + 1))
        end)
        local seedValue = NetAtk.seed:InvokeServer() * 2
        local xorValue = bit32.bxor(NetAtk.id + 909090, seedValue)
        NetAtk.cloneref(NetAtk.remote):FireServer(remoteName, xorValue, head, targets)
    end
end

-- Mantém no máximo N ciclos em andamento (N depende do modo de ataque escolhido).
-- Cada ciclo ocupa um "slot" que EXPIRA em 1,2s: se o servidor demorar a responder, o slot é liberado
-- e o ataque continua (antes ele parava por até 5s quando um ciclo ficava preso).
NetAtk.slots, NetAtk.seq = {}, 0
local function netInflight()
    local now, n = os.clock(), 0
    for id, t in pairs(NetAtk.slots) do
        if now - t > 1.2 then NetAtk.slots[id] = nil else n += 1 end
    end
    return n
end

doNetAttack = function()
    if not NetAtk.ready then return false end
    local limit = NET_LIMIT[Config.AttackMode] or 1
    local gap = NET_GAP[Config.AttackMode] or 0.1
    -- freio gradual pelo tempo de frame: o jogo engasgando é o que causa o crash
    if Perf.ema > 0.045 then
        limit, gap = 1, math.max(gap, 0.12)
    elseif Perf.ema > 0.028 then
        limit = math.max(1, math.ceil(limit / 2))
        gap = math.max(gap, 0.03)
    end
    local now = os.clock()
    if now - netLastLaunch < gap then return true end
    local free = limit - netInflight()
    for _ = 1, math.max(0, free) do
        netLastLaunch = os.clock()
        NetAtk.seq += 1
        local id = NetAtk.seq
        NetAtk.slots[id] = netLastLaunch
        task.spawn(function()
            pcall(netAttackOnce)
            NetAtk.slots[id] = nil
            NetAtk.lastDone = os.clock()
        end)
    end
    return true
end

-- ============ LUTA (posição, puxar mobs, medir dano) ============
local Fight = { active = false, expires = 0, standCF = nil, pullCF = nil, mobs = {}, inPos = false, pos = nil, enemy = nil }

-- Altura efetiva: a escolhida nas Settings; desce sozinha se o ataque não causar dano
local PULL_GAP = 13 -- distância vertical entre o jogador e o mob puxado (cabe 1 jogador no meio)
local function effHover(canPull)
    local h = Config.HoverHeight
    if Watch.stage >= 2 then
        h = math.min(h, 16)
    elseif Watch.stage == 1 then
        h = math.min(h, 20)
    end
    if not canPull then h = math.min(h, 16) end -- boss: sempre perto
    return h
end

-- Mede se o alvo está perdendo vida; se não estiver (por 3s, já em posição), troca de método
local function watchStep(enemy, eh)
    local now = os.clock()
    if Watch.enemy ~= enemy then
        Watch.enemy, Watch.hp, Watch.lastDmg = enemy, eh.Health, now
    else
        if eh.Health < Watch.hp - 0.01 then
            Watch.lastDmg, Watch.confirmed = now, true
        end
        Watch.hp = eh.Health
    end
    if not Fight.inPos then
        Watch.lastDmg = now -- ainda voando: não conta
        return
    end
    if Config.AttackMethod ~= "Auto" then return end
    if now - Watch.lastDmg > 2 then
        Watch.confirmed = false
        Watch.lastDmg = now
        for _ = 1, #METHODS do
            Watch.mi = Watch.mi % #METHODS + 1
            if Watch.mi == 1 then Watch.stage = (Watch.stage + 1) % 3 end
            if not Watch.skip[METHODS[Watch.mi]] then break end
        end
    end
end

-- Mobs do mesmo tipo para puxar junto (total = Config.Bring, contando o alvo)
local function collectBring(main, names, center)
    local list = { main }
    for _, e in ipairs(enemiesList()) do
        if #list >= Config.Bring then break end
        if e ~= main and matchName(e.Name, names) then
            local eh, er = aliveParts(e)
            if eh and (er.Position - center).Magnitude < 350 then
                list[#list + 1] = e
            end
        end
    end
    return list
end

-- Posiciona o jogador no alto e puxa o mob para 3 studs ABAIXO dele (o golpe alcança de cima).
-- A posição é reaplicada a cada frame (Heartbeat) para o mob não voltar ao chão entre um ciclo e outro.
local GUN_DIST = 9 -- Gun: o mob fica 9 studs à frente, na MESMA altura (câmera reta)
local function fightEnemy(enemy, names, canPull)
    local eh, er = aliveParts(enemy)
    if not eh then return end
    equipWeapon()
    local gun = (Config.Weapon == "Gun")
    Aim.level = gun
    if not canPull then State.bossAt = os.clock() end -- lutando contra boss: o Collect Fruit espera

    if Fight.enemy ~= enemy then
        Fight.enemy = enemy
        Fight.pos = er.Position -- posição original do mob, antes de puxar
    end
    local base = canPull and Fight.pos or er.Position
    local h = effHover(canPull)
    local stand, pullCF
    if gun then
        if canPull then
            local p = base + Vector3.new(0, h, 0)
            stand = CFrame.lookAt(p, p + Vector3.new(0, 0, 1))
            pullCF = CFrame.new(p + Vector3.new(0, 0, GUN_DIST))
        else
            local p = er.Position + Vector3.new(0, 4, -14)
            stand = CFrame.lookAt(p, Vector3.new(er.Position.X, p.Y, er.Position.Z))
        end
    else
        stand = CFrame.new(base + Vector3.new(0, h, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
        if canPull then pullCF = CFrame.new(base + Vector3.new(0, h - math.min(PULL_GAP, h - 4), 0)) end
    end
    Fight.standCF, Fight.pullCF = stand, pullCF
    Fight.mobs = canPull and collectBring(enemy, names, base) or {}
    Fight.active, Fight.expires = true, os.clock() + 0.5

    -- ataca só 2 mobs por vez (revezando entre os puxados)
    Batch.update(#Fight.mobs > 0 and Fight.mobs or { enemy })
    local _, tr = aliveParts(Batch.pair[1] or enemy)
    Aim.part = tr or er

    local near = false
    local _, hrp = getChar()
    if hrp then
        Fight.inPos = (hrp.Position - stand.Position).Magnitude < 8
        near = (hrp.Position - er.Position).Magnitude < 40
        if Fight.inPos then
            if currentTween then currentTween:Cancel() end
        else
            flyTo(stand)
        end
    end

    watchStep(enemy, eh)
    if Fight.inPos or near then Config.AttackUntil = os.clock() + 0.8 end -- liga o ataque automático
    Diag.attack = string.format("método=%s%s | altura=%s | dano confirmado=%s | net=%s",
        currentMethod(), (Config.AttackMethod == "Auto") and " (auto)" or "",
        tostring(math.floor(h)), Watch.confirmed and "sim" or "ainda não",
        NetAtk.ready and "pronto" or NetAtk.err)
    Diag.attack = Diag.attack .. fruitNote()
end

table.insert(Connections, RunService.Heartbeat:Connect(function()

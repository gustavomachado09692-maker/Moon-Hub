-- Thread de ataque: só clica quando alguma rotina marcou "AttackUntil".
-- Cada passo roda dentro de pcall: um erro isolado NÃO mata mais a thread (era o que fazia o ataque parar).
local lastPoint = 0
local function attackTick()
    if not (State.Busy and os.clock() < Config.AttackUntil) then
        Aim.on = false
        return 0.1
    end
    local cam = workspace.CurrentCamera
    local method = currentMethod()
    local gunLike = (Config.Weapon == "Gun")
    local synthetic = (method == "Mouse" or method == "Touch")
    -- a câmera só é controlada com Gun/fruta; com Melee/Sword ela fica livre
    Aim.on = gunLike and (synthetic or method == "Tool")
    if cam and os.clock() - lastPoint > 0.3 then
        lastPoint = os.clock()
        if synthetic then
            Aim.px, Aim.py = safePoint(cam.ViewportSize)
        else
            Aim.px, Aim.py = cursorPoint(cam.ViewportSize)
        end
    end
    doAttack(method)
    if method == "Net" then
        -- o ritmo vem dos slots; Fast/Super não esperam nada (1 frame)
        return (Config.AttackMode == "Normal Attack") and 0.01 or 0
    end
    local cps = AttackCPS[Config.AttackMode] or 3
    if Config.Weapon == "Gun" then cps = math.min(cps, 8) end -- arma de fogo tem delay de tiro
    return (1 / cps) * (0.85 + math.random() * 0.3)
end


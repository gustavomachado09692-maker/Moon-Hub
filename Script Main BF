-- Mar 3: Pirate Raid - mobs dos Mares 1/2 aparecem perto do Castle on the Sea (a cada ~1h15)
local PR = { lastSeen = 0, lastProbe = 0, probeUntil = 0 }
local PIRATE_POINT = CFrame.new(-5539, 313, -2972) -- Castle on the Sea (posição aproximada)
local function pirateRaidStep()
    local _, hrp = getChar()
    if not hrp then return false end
    local best, bestDist = nil, math.huge
    for _, e in ipairs(enemiesList()) do
        if RaidSet[e.Name] then
            local eh, er = aliveParts(e)
            if eh then
                local d = (hrp.Position - er.Position).Magnitude
                if d < bestDist then best, bestDist = e, d end
            end
        end
    end
    local now = os.clock()
    if best then
        PR.lastSeen = now
        State.Mode = "Auto Pirate Raid"
        State.Text = "Matando " .. best.Name
        fightEnemy(best, { best.Name }, true)
        return true
    end
    -- Os mobs da raid só carregam perto do Castle on the Sea. Entre uma onda e outra, fica por lá.
    if now - PR.lastSeen < 25 then
        State.Mode, State.Text = "Auto Pirate Raid", "Aguardando a próxima onda"
        if distanceTo(PIRATE_POINT) > 150 then flyTo(PIRATE_POINT * CFrame.new(0, 40, 0)) end
        return true
    end
    -- Sem raid à vista: a cada 90s vai ao Castle olhar se ela começou (tempo da viagem + 6s)
    if now >= PR.probeUntil and now - PR.lastProbe > 90 then
        PR.lastProbe = now
        PR.probeUntil = now + distanceTo(PIRATE_POINT) / math.max(Config.TweenSpeed, 50) + 6
    end
    if now < PR.probeUntil then
        State.Mode, State.Text = "Auto Pirate Raid", "Procurando a raid no Castle on the Sea"
        flyTo(PIRATE_POINT * CFrame.new(0, 40, 0))
        return true
    end
    return false
end

-- Mar 3: Elite Hunter - pega a quest e mata o Deandre / Urban / Diablo
local EliteAsk = 0
local EliteS = { travelSince = 0, pauseUntil = 0 }
-- NPC Elite Hunter (procura no workspace.NPCs; senão usa a posição conhecida perto do Castle on the Sea)
local function eliteNpcCF()
    local npcs = workspace:FindFirstChild("NPCs")
    local m = npcs and npcs:FindFirstChild("Elite Hunter")
    local part = m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart"))
    return part and part.CFrame or CFrame.new(-5418, 314, -2825)

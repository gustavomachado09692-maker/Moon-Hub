local BLUE = Color3.fromRGB(64, 140, 255)
local TITLE_RICH = '<font color="#FFFFFF">Moon Hub</font> <font color="#FFDD00">( No-Key )</font>'
local SUB_RICH   = '<font color="#FF2828">[ BETA ]</font>'

-- Mantém uma propriedade fixa: se a Fluent mudar (ao ativar uma opção, por ex.), volta ao valor
local function lockProp(inst, prop, value)
    pcall(function()
        inst[prop] = value
        inst:GetPropertyChangedSignal(prop):Connect(function()
            pcall(function() if inst[prop] ~= value then inst[prop] = value end end)
        end)
    end)
end

-- Fundo um pouco mais escuro (só os cinzas; não mexe nas cores de destaque dos toggles)
local function darken(obj)
    if not (obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("CanvasGroup")
        or obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("TextBox")) then return end
    if obj:GetAttribute("MHDark") then return end
    local c = obj.BackgroundColor3
    local mx, mn = math.max(c.R, c.G, c.B), math.min(c.R, c.G, c.B)
    if mx - mn < 0.08 and mx > 0.03 then
        obj:SetAttribute("MHDark", true)
        obj.BackgroundColor3 = Color3.new(c.R * 0.75, c.G * 0.75, c.B * 0.75)
    end
end

local function styleWindow()
    pcall(function() Fluent:SetTheme("Darker") end)
    local root = Window and Window.Root
    if not root then return end
    -- contorno azul só na borda da janela
    pcall(function()
        local st = root:FindFirstChildOfClass("UIStroke")
        if not st then
            st = Instance.new("UIStroke")
            st.Parent = root
        end
        st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        if not st:GetAttribute("MHLock") then
            st:SetAttribute("MHLock", true)
            lockProp(st, "Color", BLUE)
            lockProp(st, "Transparency", 0)
            lockProp(st, "Thickness", 2)
            lockProp(st, "Enabled", true)
        end
    end)
    for _, d in ipairs(root:GetDescendants()) do
        pcall(darken, d)
        -- título: [ BETA ] vermelho | Moon Hub branco | ( No-Key ) amarelo (rich text: não some ao ativar opções)
        if d:IsA("TextLabel") and not d:GetAttribute("MHTitle") then
            if d.Text == "Moon Hub ( No-Key )" then
                d:SetAttribute("MHTitle", true)
                lockProp(d, "RichText", true)
                lockProp(d, "Text", TITLE_RICH)
            elseif d.Text == "[ BETA ]" then
                d:SetAttribute("MHTitle", true)
                lockProp(d, "RichText", true)
                lockProp(d, "Text", SUB_RICH)
                lockProp(d, "TextColor3", Color3.fromRGB(255, 40, 40))
            end
        end
    end
end

-- ============ PERSONAGEM / MOVIMENTO ============
local function getChar()
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return char, hrp, hum end
end

local function distanceTo(cf)
    local _, hrp = getChar()
    return hrp and (hrp.Position - cf.Position).Magnitude or math.huge
end

-- Voo suave por tween (duração proporcional à distância e à velocidade)
local currentTween
local function flyTo(targetCF)
    local _, hrp = getChar()
    if not hrp then return end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist < 4 then return end
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(hrp,
        TweenInfo.new(dist / Config.TweenSpeed, Enum.EasingStyle.Linear),
        { CFrame = targetCF })
    currentTween:Play()
end

-- Noclip + flutuação enquanto o script estiver controlando o personagem
local NoclipLast = 0
table.insert(Connections, RunService.Stepped:Connect(function()
    if not (Alive and State.Busy) then return end
    local char, hrp = getChar()
    if not char then return end
    local now = os.clock()
    if now - NoclipLast > 0.2 then
        NoclipLast = now
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    if not hrp:FindFirstChild("FarmHold") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FarmHold"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end
end))

local function releaseChar()
    local _, hrp = getChar()
    if hrp and hrp:FindFirstChild("FarmHold") then hrp.FarmHold:Destroy() end
    if currentTween then currentTween:Cancel() end
end

-- ============ ARMAS ============
-- Procura uma ferramenta pelo tipo (ToolTip): Melee | Sword | Gun | Blox Fruit
local function findTool(tip)
    local function scan(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == tip then
                -- frutas físicas (no inventário) têm "Fruit" no nome: não são a fruta comida
                if not (tip == "Blox Fruit" and string.find(t.Name, "Fruit")) then return t end
            end
        end
    end
    local eq = scan(Player.Character)
    if eq then return eq, true end
    local bp = scan(Player.Backpack)
    if bp then return bp, false end
end

local function equipWeapon()
    local char, _, hum = getChar()
    if not char then return end
    local tool, equipped = findTool(Config.Weapon)
    if tool and not equipped then hum:EquipTool(tool) end
end

-- Frutas com M1 suportado (a fruta que você comeu: Dragon East/West, T-Rex, Gas, Ice, Light)
local FRUIT_M1 = { "dragon", "t-rex", "gas", "ice", "light" }
local function fruitNote()
    if Config.Weapon ~= "Blox Fruit" then return "" end
    local tool = findTool("Blox Fruit")
    if not tool then return " | fruta: nenhuma fruta comida encontrada" end
    local n = string.lower(tool.Name)
    for _, k in ipairs(FRUIT_M1) do
        if string.find(n, k, 1, true) then return " | fruta M1: " .. tool.Name .. " (ok)" end
    end
    return " | fruta M1: " .. tool.Name .. " (fora da lista: Dragon, T-Rex, Gas, Ice, Light)"
end

-- ============ ATAQUE ============
-- O jogo só registra o golpe se o clique for "real" e o cursor estiver sobre o mob.
-- Por isso: (1) a câmera é apontada para o mob e o clique cai FORA da janela da Fluent;
-- (2) existem vários métodos de ataque. O script mede se o mob perdeu vida e, se não perdeu,
--     troca sozinho de método (e depois desce a altura) até achar uma combinação que cause dano.
local Aim = { part = nil, on = false, camChanged = false, px = nil, py = nil, level = false }
-- Ciclo automático: sem Mouse/Touch (clique sintético trava o cursor). Esses dois continuam no menu, só manual.
local METHODS = { "Net", "CombatFramework", "Tool", "VirtualUser" }
local Watch = { enemy = nil, hp = 0, lastDmg = 0, mi = 1, stage = 0, confirmed = false, skip = {} }
local Fail = {}

local function currentMethod()
    -- Gun / Blox Fruit: dispara com Tool:Activate (sem clique sintético) e a câmera mira no cursor
    if Config.Weapon == "Gun" and (Config.AttackMethod == "Auto" or Config.AttackMethod == "Net") then
        return "Tool"
    end
    return (Config.AttackMethod ~= "Auto") and Config.AttackMethod or METHODS[Watch.mi]
end

local function restoreCamera()
    if not Aim.camChanged then return end
    Aim.camChanged = false
    pcall(function()
        local cam = workspace.CurrentCamera
        cam.CameraType = Enum.CameraType.Custom
        local _, _, hum = getChar()
        if hum then cam.CameraSubject = hum end
    end)
end

-- Retângulo da janela da Fluent (para o clique nunca cair em cima dela)
local function windowRect()
    local ok, r = pcall(function()
        local root = Window and Window.Root
        if root then
            if not root.Visible then return false end
            local p, sz = root.AbsolutePosition, root.AbsoluteSize
            return { p.X, p.Y, p.X + sz.X, p.Y + sz.Y }
        end
    end)
    if ok and r == false then return nil end -- janela escondida
    if ok and r then return r end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    return { vp.X / 2 - 300, vp.Y / 2 - 240, vp.X / 2 + 300, vp.Y / 2 + 240 } -- estimativa
end

-- Posição atual do cursor (a câmera aponta o mob para ESSE pixel, então não é preciso clicar em outro lugar)
local function cursorPoint(vp)
    local ok, loc = pcall(function() return UserInputService:GetMouseLocation() end)
    if ok and loc and loc.X > 1 and loc.Y > 1 and loc.X < vp.X - 1 and loc.Y < vp.Y - 1 then
        return math.clamp(loc.X, vp.X * 0.1, vp.X * 0.9), math.clamp(loc.Y, vp.Y * 0.1, vp.Y * 0.9)
    end
    return vp.X * 0.5, vp.Y * 0.5
end

-- Escolhe um ponto da tela livre da janela
local function safePoint(vp)
    local rect = windowRect()
    local cands = { { 0.88, 0.50 }, { 0.12, 0.50 }, { 0.88, 0.30 }, { 0.12, 0.30 }, { 0.50, 0.12 }, { 0.88, 0.70 } }
    for _, c in ipairs(cands) do
        local x, y = vp.X * c[1], vp.Y * c[2]
        if (not rect) or x < rect[1] - 30 or x > rect[3] + 30 or y < rect[2] - 30 or y > rect[4] + 30 then
            return x, y
        end
    end
    return vp.X * 0.5, vp.Y * 0.5
end

-- Câmera olhando para o alvo, de modo que ele apareça exatamente no pixel (px, py)
local function aimCFrame(camPos, target, px, py, vp, fov)
    local base = CFrame.lookAt(camPos, target)
    local t = math.tan(math.rad(fov) / 2)
    local ax = math.atan(((px - vp.X / 2) / (vp.Y / 2)) * t)
    local ay = math.atan(((py - vp.Y / 2) / (vp.Y / 2)) * t)
    return base * CFrame.fromEulerAnglesYXZ(ay, ax, 0)
end

-- Clique/toque real (entra como input do jogador, o jogo não ignora)

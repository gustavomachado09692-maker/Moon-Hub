local function describe(v)
    if type(v) == "table" then
        local parts, n = {}, 0
        for k, x in pairs(v) do
            n += 1
            if n > 5 then break end
            parts[#parts + 1] = tostring(k) .. "=" .. tostring(x)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function npcPart(m)
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

-- Nomes de NPCs por perto (ajuda a achar o NPC certo se o gacha mudar de nome)
local function nearbyNpcNames()
    local names, seen = {}, {}
    local _, hrp = getChar()
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs and hrp then
        for _, m in ipairs(npcs:GetChildren()) do
            local part = npcPart(m)
            if part and not seen[m.Name] and (part.Position - hrp.Position).Magnitude < 400 then
                seen[m.Name] = true
                names[#names + 1] = m.Name
                if #names >= 8 then break end
            end
        end
    end
    return #names > 0 and table.concat(names, ", ") or "nenhum"
end

local ZiolesCache, ZiolesLast = nil, 0
local function findGachaNpc()
    local _, hrp = getChar()
    -- NPC "Zioles": primeiro em workspace.NPCs, depois uma busca geral (no máx. a cada 5s)
    if ZiolesCache and ZiolesCache.Parent then return ZiolesCache end
    local z = workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("Zioles")
    if not z and os.clock() - ZiolesLast > 5 then
        ZiolesLast = os.clock()
        z = workspace:FindFirstChild("Zioles", true)
    end
    if z and z:IsA("Model") and npcPart(z) then
        ZiolesCache = z
        return z
    end
    local npcs = workspace:FindFirstChild("NPCs")

local function fruitInfo(tool)
    local raw = string.lower(tostring(tool:GetAttribute("OriginalName") or tool.Name))
    if string.find(raw, "skin", 1, true) then return nil end
    for _, f in ipairs(FruitTable) do
        local b = f[1]
        if string.sub(raw, 1, #b) == b then
            local nx = string.sub(raw, #b + 1, #b + 1)
            if nx == "" or nx == "-" or nx == " " then return f end
        end
    end
end

local function payEligible(f, only1M)
    if not f or f[3] == "M" then return false end
    if only1M and (f[3] == "L" or f[2] >= 1000000) then return false end
    return true
end


-- Só um modo de farm por vez (Level / Dough Prince / Dough King / Bones): ligar um desliga os outros
local Toggles = {}
local function addModeToggle(id, title, mode, needSea3, desc)
    local t = Tabs.Normal:AddToggle(id, { Title = title, Description = desc, Default = false })
    Toggles[mode] = t
    t:OnChanged(function(v)
        if v then
            if needSea3 and getSea() ~= 3 then
                Fluent:Notify({ Title = "Moon Hub", Content = title .. " só funciona no Mar 3.", Duration = 5 })
                t:SetValue(false)
                return
            end
            Config.Mode = mode
            for m, other in pairs(Toggles) do
                if m ~= mode and other.Value then other:SetValue(false) end
            end
        elseif Config.Mode == mode then
            Config.Mode = nil
        end
    end)
end
local function addOpt(tab, id, title, desc, key, default)
    tab:AddToggle(id, { Title = title, Description = desc, Default = default or false })
        :OnChanged(function(v) Config[key] = v end)
end
-- Sub título: um título escrito (sem caixa), menor que os títulos normais
local function subTitle(tab, text)
    local seen = {}
    for _, d in ipairs(Window.Root:GetDescendants()) do
        if d:IsA("TextLabel") then seen[d] = true end
    end
    pcall(function() tab:AddSection(text) end)
    for _, d in ipairs(Window.Root:GetDescendants()) do
        if d:IsA("TextLabel") and not seen[d] and d.Text == text then
            pcall(function()
                d.TextSize = 12
                d.TextTransparency = 0.15
            end)
            break
        end
    end
end


-- Auto Raid: mata os mobs da raid e segue para a ilha mais avançada
local function raidFightStep()
    State.Mode = "Auto Raid"
    local _, hrp = getChar()
    local best, bd = nil, 600
    for _, e in ipairs(enemiesList()) do
        local eh, er = aliveParts(e)
        if eh and hrp then
            local d = (hrp.Position - er.Position).Magnitude
            if d < bd then best, bd = e, d end
        end
    end
    if best then
        State.Text = "Raid: matando " .. best.Name
        fightEnemy(best, { best.Name }, true)
        return true
    end
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then
        for i = 5, 1, -1 do
            local isl = loc:FindFirstChild("Island " .. i)
            local cf = isl and posOf(isl)
            if cf then
                State.Text = "Raid: indo para a ilha " .. i
                flyTo(cf * CFrame.new(0, 40, 0))
                return true
            end
        end
    end
    State.Text = "Raid: aguardando mobs"
    return true
end

-- Retorna true enquanto estiver usando o personagem
local function raidStep()
    if not (Config.AutoStartRaid or Config.AutoRaid or Config.AutoPay) then return false end
    local sea = getSea()
    if sea == 1 then
        Diag.raid = "Raids só existem nos Mares 2 e 3"
        return false
    end
    if raidActive() then
        if Config.AutoRaid then return raidFightStep() end
        return false
    end
    local now = os.time()
    local chip = hasChip()
    if not chip and Config.AutoPay and now >= Raid.payAt and getPlayerLevel() >= 1100 then
        State.Mode, State.Text = "Raids", "Comprando chip (" .. Config.RaidType .. ")"
        if payChip() then
            Raid.fails = 0
            chip = true
        else
            Raid.fails += 1
            Raid.payAt = now + ((Raid.fails < 3) and 60 or 600)
        end
    end
    if chip and Config.AutoStartRaid and os.clock() - Raid.pressAt > 12 then
        local btn = raidButton()
        if not btn then
            Diag.raid = "botão da Raid não encontrado: vá até Hot and Cold Island (Mar 2) ou Castle on the Sea (Mar 3)"
            return false
        end
        State.Mode = "Raids"
        if distanceTo(btn.CFrame) > 25 then
            State.Text = "Indo ao botão da Raid"
            flyTo(btn.CFrame * CFrame.new(0, 6, 8))
            return true
        end
        State.Text = "Iniciando a Raid"
        pcall(function() fireclickdetector(btn:FindFirstChildOfClass("ClickDetector")) end)
        Raid.pressAt = os.clock()
        Diag.raid = "botão apertado (" .. Config.RaidType .. ")"
        return true
    elseif not chip and Config.AutoStartRaid and not Config.AutoPay then
        Diag.raid = "sem Special Microchip (ligue o Auto Pay ou compre o chip)"
    end
    return false
end


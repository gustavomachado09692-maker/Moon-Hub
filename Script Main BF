local Buy = { epoch = nil, reads = 0 }
local function buyStep()
    local epoch = math.floor(os.time() / 14400)
    if Buy.epoch == epoch then return end
    local prios = {}
    for _, f in ipairs(Config.BuyPrio) do
        if f and f ~= "Nenhuma" then prios[#prios + 1] = f end
    end
    if #prios == 0 then
        Diag.buy = "escolha ao menos 1 fruta nas prioridades"
        return
    end
    local ok, stock = invoke("GetFruits")
    if not ok or type(stock) ~= "table" then
        Buy.reads += 1
        Diag.buy = "não consegui ler o stock: " .. tostring(stock)
        if Buy.reads >= 3 then Buy.epoch, Buy.reads = epoch, 0 end
        return
    end
    Buy.reads, Buy.epoch = 0, epoch -- daqui em diante: só 1 tentativa neste stock
    local hasFlag, onSale = false, {}
    for _, v in pairs(stock) do
        if type(v) == "table" and v.Name then
            if v.OnSale ~= nil then hasFlag = true end
        end
    end
    for _, v in pairs(stock) do
        if type(v) == "table" and v.Name and ((not hasFlag) or v.OnSale == true) then
            onSale[string.lower(v.Name)] = v.Name
        end
    end
    for i, want in ipairs(prios) do
        local real = onSale[string.lower(want)]
        if real then
            local ok2, r = invoke("PurchaseRawFruit", real)
            Diag.buy = string.format("prioridade %d (%s): %s -> %s", i, real, ok2 and "tentei comprar" or "erro", tostring(r))
            return
        end
    end
    Diag.buy = "nenhuma fruta da sua lista está no stock normal agora"
end


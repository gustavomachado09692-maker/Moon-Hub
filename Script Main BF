-- Retorna true enquanto estiver usando o personagem (voando até o NPC)
local function gachaMission()
    local now = os.time()
    if now < Gacha.nextAt or now < Gacha.pauseUntil then return false end
    if getPlayerLevel() < 50 then
        Diag.gacha = "nível mínimo 50 para o gacha"
        return false
    end

    -- 1) tentativa direta, de onde estiver
    if Gacha.phase == "idle" then
        local done, why, secs = tryRoll()
        if done then
            Gacha.nextAt = os.time() + (secs or 7200)
            Gacha.tries = 0
            saveGacha()
            Diag.gacha = "ok (" .. why .. ") | " .. Gacha.last
            return false
        end
        Gacha.phase, Gacha.travelSince = "travel", os.clock()
    end

    -- 2) vai até o NPC (no máximo 40s de viagem)
    local npc = findGachaNpc()
    local part = npc and npcPart(npc)
    if part and distanceTo(part.CFrame) > 10 and os.clock() - Gacha.travelSince < 40 then
        State.Mode, State.Text = "Auto Random Fruit", "Indo ao Zioles"
        flyTo(part.CFrame * CFrame.new(0, 4, 5))
        return true
    elseif not part and getSea() == 1 and os.clock() - Gacha.travelSince < 40 then
        -- Zioles ainda não carregou (o jogo só carrega NPCs perto): vai para Middle Town (posição aproximada)
        State.Mode, State.Text = "Auto Random Fruit", "Indo a Middle Town (procurando Zioles)"
        flyTo(CFrame.new(-655, 12, 1573))
        return true
    end

    -- 3) chegou (ou o NPC não foi achado): remote de novo, depois prompt/botão
    State.Mode, State.Text = "Auto Random Fruit", "Girando"
    local done, why, secs = tryRoll()
    if not done and npc then
        local before, beforeInv = countFruits(), invFruitCount()
        pressGachaUi(npc)
        task.wait(2)
        if gotFruit(before, beforeInv) then done, why = true, "fruta recebida (NPC/janela)" end
    end
    Gacha.phase = "idle"
    if done then
        Gacha.nextAt = os.time() + (secs or 7200)
        Gacha.tries = 0
        saveGacha()
        Diag.gacha = "ok (" .. why .. ") | " .. Gacha.last
        return false
    end
    Gacha.pauseUntil = os.time() + ((Gacha.tries < 3) and 120 or 900)
    Diag.gacha = string.format("falhou (%d tentativas) | %s | NPC: %s | NPCs por perto: %s",
        Gacha.tries, Gacha.last, npc and npc.Name or "não achado", nearbyNpcNames())
    return false
end

-- Auto Collect: frutas no chão (inclusive as que acabaram de nascer)
local FruitBlacklist = setmetatable({}, { __mode = "k" })
local CollectTarget, CollectStart = nil, 0

local function findGroundFruit()
    local _, hrp = getChar()
    if not hrp then return end
    local best, bestDist = nil, math.huge
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Tool") and string.find(v.Name, "Fruit") and (FruitBlacklist[v] or 0) < os.clock() then
            local handle = v:FindFirstChild("Handle")
            if handle then
                local d = (hrp.Position - handle.Position).Magnitude
                if d < bestDist then best, bestDist = v, d end
            end
        end
    end
    return best
end

local function collectStep(fruit)
    local handle = fruit:FindFirstChild("Handle")
    if not handle then return end
    if CollectTarget ~= fruit then CollectTarget, CollectStart = fruit, os.clock() end
    if os.clock() - CollectStart > 25 then -- travou: ignora essa fruta por 60s
        FruitBlacklist[fruit] = os.clock() + 60
        CollectTarget = nil
        return
    end
    State.Mode = "Auto Collect Fruit"
    State.Text = "Coletando " .. fruit.Name
    flyTo(handle.CFrame)
    local _, hrp = getChar()
    if hrp and (hrp.Position - handle.Position).Magnitude < 15 then
        pcall(function()
            firetouchinterest(hrp, handle, 0)
            firetouchinterest(hrp, handle, 1)
        end)
    end
end

